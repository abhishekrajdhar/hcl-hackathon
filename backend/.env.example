# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Learning Path Recommender API"
APP_VERSION=0.1.0
ENVIRONMENT=local            # local | development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-secret-key-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated or a JSON array
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Inside docker compose use POSTGRES_HOST=postgres; on the host use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lpr
POSTGRES_PASSWORD=lpr
POSTGRES_DB=lpr
# Optional full DSN override (wins over the parts above):
# DATABASE_URL=postgresql+asyncpg://lpr:lpr@localhost:5432/lpr

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---------------------------------------------------------------------------
# Cache (reserved for a later phase)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Embeddings
# Changing EMBEDDING_DIM requires a migration: it is the pgvector column width.
# ---------------------------------------------------------------------------
EMBEDDING_DIM=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console           # json | console

# ---------------------------------------------------------------------------
# Bootstrap admin (created by `python -m app.db.seed`)
# ---------------------------------------------------------------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ---------------------------------------------------------------------------
# LLM provider (profile extraction). Default "mock" needs no credentials.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock            # mock | claude | openai
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_REPAIR_ATTEMPTS=1

# Claude (LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI / OpenAI-compatible. One key powers BOTH the LLM and the embeddings:
#   LLM_PROVIDER=openai         -> chat, explanations, profile extraction
#   EMBEDDING_PROVIDER=openai   -> real semantic search and recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Embeddings (semantic search). Default "mock" needs no heavy dependency.
# For real embeddings: set EMBEDDING_PROVIDER=sentence_transformer and install
# sentence-transformers (see requirements-embeddings.txt). EMBEDDING_DIM must
# match the model (all-MiniLM-L6-v2 = 384).
# ---------------------------------------------------------------------------
# mock                 token-hashing, no key, no dependency (default)
# openai                real semantic vectors; needs OPENAI_API_KEY
# sentence_transformer  local model; needs requirements-embeddings.txt (torch)
# Switching provider changes what the vectors MEAN, so re-embed afterwards:
#   POST /api/v1/resources/embed-all
EMBEDDING_PROVIDER=mock          # mock | openai | sentence_transformer
EMBEDDING_DIM=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_QUERY_CACHE_SIZE=512
